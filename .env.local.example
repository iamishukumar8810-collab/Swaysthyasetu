# ==============================================================================
# SWASTHYA SETU - ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================
# Instructions:
# 1. Copy this file to .env (or .env.local):
#    cp .env.example .env
# 2. Add your OPENAI_API_KEY below.
# ==============================================================================

# ==============================================================================
# 1. AI CLINICAL CHATBOT & TRIAGE (PRIMARY PROVIDER)
# ==============================================================================
# [REQUIRED FOR LIVE OPENAI RESPONSES]
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# (Optional) Model name to use (Default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini


# ==============================================================================
# 2. MULTI-MODEL FALLBACK PROVIDERS (OPTIONAL)
# ==============================================================================
# If the OpenAI token quota fails or runs out, the system cascades automatically:
# OpenAI -> Gemini -> Claude -> AYUSH Clinical Fallback Engine.

# Google Gemini API Key (Fallback 1)
# Get key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# (Optional) Gemini model
GEMINI_MODEL=gemini-1.5-flash

# Anthropic Claude API Key (Fallback 2)
# Get key from: https://console.anthropic.com/
CLAUDE_API_KEY=

# (Optional) Claude model
CLAUDE_MODEL=claude-3-haiku-20240307


# ==============================================================================
# 3. SUPABASE DATABASE & AUTHENTICATION (OPTIONAL)
# ==============================================================================
# Get these from your Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
